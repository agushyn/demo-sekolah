APP_NAME="SMA Nusantara"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://sekolah.sch.id

APP_LOCALE=id
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=id_ID
APP_TIMEZONE=Asia/Jakarta

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=info

# Database Production (MySQL / MariaDB / PostgreSQL / SQLite)
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=schid_production
DB_USERNAME=schid_dbuser
DB_PASSWORD=secret_db_password

# Session Configuration (HTTPS Production)
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=true
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=lax

# Broadcasting & Filesystem
BROADCAST_CONNECTION=log
FILESYSTEM_DISK=public

# Queue & Cache Driver (database / redis)
QUEUE_CONNECTION=database
CACHE_STORE=database
CACHE_PREFIX=schid_cache_

# Redis Configuration (Optional)
REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# Mail Production (SMTP / Mailgun / SES / Postmark)
MAIL_MAILER=smtp
MAIL_SCHEME=null
MAIL_HOST=smtp.mailgun.org
MAIL_PORT=587
MAIL_USERNAME=postmaster@sekolah.sch.id
MAIL_PASSWORD=secret_smtp_password
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS="info@sekolah.sch.id"
MAIL_FROM_NAME="${APP_NAME}"

# Supabase Attendance Provider (Optional Environment Overrides)
# Note: Primary configuration can also be configured dynamically via Admin -> Pengaturan Sistem
SUPABASE_URL=
SUPABASE_KEY=
ATTENDANCE_API_TIMEOUT=15

# Vite Production Asset Naming
VITE_APP_NAME="${APP_NAME}"
